#!/bin/sh
# Runs once at boot (as root) when tdm.tcz is loaded from onboot.lst.
#
# Mode comes from the GRUB menu as tdm=<mode> on the kernel command line:
#   auto    (default) switch the panel to the external input, then start
#           tdm-guard which watches the SMC and repairs a dropped link.
#   once    switch once, no guard (the classic behaviour).
#   console stay on the Linux console, switch nothing (read the logs).
#
# Logging (evidence first, never trust one path):
#   1. every line goes to RAM (/tmp/tdm-log/boot.log) AND to the kernel ring
#      buffer (/dev/kmsg, prefix "tdm:") so `dmesg` always has the trace;
#   2. the key is located three ways (tcedir symlink, /mnt/*/tce/onboot.lst,
#      mount by LABEL=TINYCORE), remounted rw if it came up read-only;
#   3. tdm-flush copies the RAM logs to <key>/tce/log/ AND <key>/tdm-boot.log
#      (root of the key) after every stage, at the end, and from tdm-guard.
#   TINYCORE/tce/log/boot.log, guard.log, dmesg.log, key.log (how the key was found)
trap "" 2
RAM=/tmp/tdm-log; mkdir -p "$RAM"
LOG="$RAM/boot.log"; : > "$LOG"
KEYFILE=/etc/sysconfig/tdm-keydir        # read by tdm-guard and tdm-flush
echo "$RAM" > /etc/sysconfig/tdm-logdir  # RAM dir (back-compat for tdm-guard)

log() {
    line="$(date '+%F %T') up=$(cut -d. -f1 /proc/uptime)s $*"
    echo "$line" >> "$LOG"
    echo "tdm: $*" > /dev/kmsg 2>/dev/null
}

MODE=auto
for a in $(cat /proc/cmdline 2>/dev/null); do
    case "$a" in tdm=*) MODE=${a#tdm=} ;; esac
done
log "=== boot mode=$MODE"
log "cmdline: $(cat /proc/cmdline)"

# --- find the key (three routes), make it writable, remember it -------------
KEYDIR=""
try_key() {   # $1 = candidate mount point holding tce/
    d=$1
    [ -n "$d" ] && [ -d "$d/tce" ] || return 1
    dev=$(awk -v m="$d" '$2==m{print $1}' /proc/mounts | head -1)
    if awk -v m="$d" '$2==m && $4 ~ /(^|,)ro(,|$)/{f=1} END{exit !f}' /proc/mounts; then
        log "key $d is read-only ($dev): remount rw"
        mount -o remount,rw "$d" 2>/dev/null || log "remount rw FAILED: $(mount -o remount,rw "$d" 2>&1)"
    fi
    if mkdir -p "$d/tce/log" 2>/dev/null && echo "$(date '+%F %T') rw-probe" > "$d/tce/log/.rw" 2>/dev/null; then
        KEYDIR=$d; log "key found: $d dev=$dev (writable)"; return 0
    fi
    log "key candidate $d ($dev) NOT writable: $(echo x > "$d/.rwtest" 2>&1; rm -f "$d/.rwtest")"
    return 1
}
# route 1: tce-setup's symlink
t=$(readlink -f /etc/sysconfig/tcedir 2>/dev/null)
log "route1 tcedir=$t link: $(ls -ld /etc/sysconfig/tcedir 2>&1)"
[ -n "$t" ] && try_key "${t%/tce}"
# route 2: any mounted dir that carries our onboot.lst
if [ -z "$KEYDIR" ]; then
    for m in /mnt/*; do
        grep -qs '^tdm.tcz' "$m/tce/onboot.lst" && try_key "$m" && break
    done
fi
# route 3: mount by label ourselves
if [ -z "$KEYDIR" ]; then
    dev=$(findfs LABEL=TINYCORE 2>/dev/null)
    [ -z "$dev" ] && dev=$(blkid 2>/dev/null | sed -n 's/^\([^:]*\):.*LABEL="TINYCORE".*/\1/p' | head -1)
    log "route3 label dev=[$dev]"
    if [ -n "$dev" ]; then
        mkdir -p /mnt/tinycore
        mount -o rw,umask=000 "$dev" /mnt/tinycore 2>/dev/null && try_key /mnt/tinycore
    fi
fi
log "mounts: $(grep -E ' /mnt/| /etc/sysconfig' /proc/mounts | tr '\n' ';')"
log "blk: $(ls /dev/sd* 2>/dev/null | tr '\n' ' ')"
echo "$KEYDIR" > "$KEYFILE"
[ -n "$KEYDIR" ] || log "WARNING no writable key found, logs stay in RAM only"
/usr/bin/tdm-flush

# 1. Hotkeys (fallback only, never required): Ctrl+Alt+F2..F6 run tdm commands.
sed -i \
  -e 's|^.*tty2::.*|tty2::askfirst:/usr/bin/tdm toggle|' \
  -e 's|^.*tty3::.*|tty3::askfirst:/usr/bin/tdm on|' \
  -e 's|^.*tty4::.*|tty4::askfirst:/usr/bin/tdm off|' \
  -e 's|^.*tty5::.*|tty5::askfirst:/usr/bin/tdm poweroff|' \
  -e 's|^.*tty6::.*|tty6::askfirst:/usr/bin/tdm cycle|' /etc/inittab
killall -HUP init

# 2. Quiet, cool machine: lowest CPU frequency, no X, help text on the console.
for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -w "$g" ] && echo powersave > "$g"
done
sed -i 's/^waitforX.*/waitforX || exit/' /home/tc/.xsession 2>/dev/null
grep -q 'tdm help' /home/tc/.profile 2>/dev/null || echo '/usr/bin/tdm help' >> /home/tc/.profile

# 3. The console must never blank (kernel also boots with consoleblank=0).
echo 0 > /sys/module/kernel/parameters/consoleblank 2>/dev/null
setterm -blank 0 -powerdown 0 -powersave off < /dev/tty1 > /dev/tty1 2>/dev/null

# 4. SMC: make sure the kernel driver does not own the ports, record the state.
/sbin/rmmod applesmc 2>/dev/null
[ -x /usr/bin/SmcDumpKey ] || log "ERROR /usr/bin/SmcDumpKey missing or not executable"
log "smc before: $(/usr/bin/tdm-guard measure 2>&1)"
/usr/bin/tdm-flush

# 5. Switch exactly like the proven classic build: one synchronous `tdm on`.
case "$MODE" in
    console)
        log "mode console: panel stays on the Linux console, nothing switched" ;;
    once|auto)
        log "tdm on ..."
        /usr/bin/tdm on >> "$LOG" 2>&1
        log "tdm on rc=$? status=$(/usr/bin/tdm status) smc after: $(/usr/bin/tdm-guard measure 2>&1)"
        /usr/bin/tdm-flush
        if [ "$MODE" = auto ]; then
            # Hardware truth (log 21:13): the first `tdm on` at boot sets MVHR=1 but
            # the panel stays black; the owner's proven fix is off, 3 s, on (F4/F3).
            # Do that kick once, automatically, before handing over to the guard.
            # Boot 21:31 (owner): the picture from the first on appears about 8-10 s after MVHR=1;
            # Boot 23:10 (owner): kicking at 1 s leaves the panel BLACK for good; the kick only
            # works after the first on has finished its ~10 s bring-up. 10 s is the proven value.
            sleep 10
            log "boot kick: off"; TDM_GUARD=1 /usr/bin/tdm off >> "$LOG" 2>&1
            sleep 3
            log "boot kick: on";  TDM_GUARD=1 /usr/bin/tdm on  >> "$LOG" 2>&1
            sleep 10
            log "boot kick done status=$(/usr/bin/tdm status) $(/usr/bin/tdm-guard measure 2>&1)"
            /usr/bin/tdm-flush
            /usr/bin/tdm-guard > /dev/null 2>&1 &
            log "tdm-guard started pid=$!"
        fi
        # Link repair from the Mac mini side (tdm-kickd): eth0 10.10.10.2, TCP 9100,
        # "KICK" = off/3s/on. Needed after a mini reboot: the mini sees "No Link",
        # MVHR is still 1 so the guard cannot know, only the mini can ask for the kick.
        /usr/bin/tdm-kickd > /dev/null 2>&1 &
        log "tdm-kickd started pid=$!" ;;
    *)
        log "unknown mode '$MODE', nothing switched" ;;
esac

dmesg 2>/dev/null | tail -80 > "$RAM/dmesg.log"
log "boot hook done"
/usr/bin/tdm-flush
