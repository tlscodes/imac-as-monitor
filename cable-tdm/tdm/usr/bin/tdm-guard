#!/bin/sh
# tdm-guard: keeps Target Display Mode up on its own, no keyboard needed.
# Started once at boot by /usr/local/tce.installed/tdm AFTER the proven
# synchronous `tdm on`; it never switches at start, it only watches and repairs.
#
#   TDM_ACTIVE   every POLL s read MVHR. 1 = panel on the external input.
#   LINK_RETRY   MVHR=0 while nobody asked for off -> the proven recovery
#                (off, on), at most one try per RETRY_MIN s, MAX_FAILS tries.
#   SAFE_CONSOLE after MAX_FAILS, or after a manual `tdm off` (Ctrl+Alt+F4):
#                the guard stops touching the SMC until a manual `tdm on`
#                (Ctrl+Alt+F3) clears /tmp/tdm.manual_off.
#
#   `tdm-guard measure`  prints the raw SMC keys MVHR MVMR MVMS (used by logs).
#   Pause: touch /tmp/tdm-guard.pause      Log: <key>/tce/log/guard.log
#
# LIMITATIONS (hardware-honest):
#   MVHR is an SMC routing state, not a DisplayPort link monitor: a black
#   picture with MVHR still 1 is not detected. MVMS meaning is unknown; its raw
#   value is only logged (heartbeat every HEARTBEAT polls and on every change)
#   so the real behaviour can be read off the key afterwards.
SMC=/usr/bin/SmcDumpKey
LOCK=/tmp/tdm.smc.lock
smc() { if command -v flock >/dev/null 2>&1; then flock "$LOCK" "$SMC" "$@"; else "$SMC" "$@"; fi; }
LOGDIR=/tmp/tdm-log; mkdir -p "$LOGDIR"   # RAM; tdm-flush mirrors it to the key
LOG="$LOGDIR/guard.log"
PID=/tmp/tdm-guard.pid
POLL=${TDM_GUARD_POLL:-15}
RETRY_MIN=${TDM_GUARD_RETRY:-60}
MAX_FAILS=${TDM_GUARD_MAX:-5}
HEARTBEAT=${TDM_GUARD_HEARTBEAT:-12}   # 12 x 15 s = every 3 min

raw() { smc "$1" 2>/dev/null | tr -s ' \n' ' ' | sed 's/^ //;s/ $//'; }
measure() { echo "MVHR=[$(raw MVHR)] MVMR=[$(raw MVMR)] MVMS=[$(raw MVMS)]"; }
[ "$1" = measure ] && { measure; exit 0; }

state=START
log() { echo "$(date '+%F %T') up=$(cut -d. -f1 /proc/uptime)s [$state] $*" >> "$LOG"; echo "tdm-guard[$state]: $*" > /dev/kmsg 2>/dev/null; /usr/bin/tdm-flush; }
up()  { cut -d. -f1 /proc/uptime; }

if [ -s "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
    log "already running as pid $(cat "$PID"), exit"; exit 0
fi
echo $$ > "$PID"
[ -x "$SMC" ] || { log "ERROR $SMC missing"; exit 1; }
ln -sf "$LOG" /tmp/tdm-guard.log 2>/dev/null

log "start pid=$$ poll=${POLL}s retry=${RETRY_MIN}s max=$MAX_FAILS log=$LOG"
log "smc: $(measure)"

state=TDM_ACTIVE
fails=0; last_try=0; n=0; last_mvms=$(raw MVMS)

while :; do
    sleep "$POLL"
    n=$((n + 1))
    mvms=$(raw MVMS)
    if [ "$mvms" != "$last_mvms" ]; then
        log "MVMS changed [$last_mvms] -> [$mvms] (status=$(/usr/bin/tdm status))"; last_mvms=$mvms
    fi
    [ $((n % HEARTBEAT)) -eq 0 ] && log "heartbeat fails=$fails $(measure)"
    [ -e /tmp/tdm-guard.pause ] && continue
    if [ -e /tmp/tdm.manual_off ]; then
        [ "$state" != SAFE_CONSOLE ] && { state=SAFE_CONSOLE; log "manual off, hands off until Ctrl+Alt+F3"; }
        continue
    fi
    if [ "$(/usr/bin/tdm status)" = off ]; then
        if [ "$fails" -ge "$MAX_FAILS" ]; then
            [ "$state" != SAFE_CONSOLE ] && { state=SAFE_CONSOLE; log "gave up after $fails tries, console stays; Ctrl+Alt+F3 retries"; }
            continue
        fi
        now=$(up)
        [ $((now - last_try)) -lt "$RETRY_MIN" ] && continue
        state=LINK_RETRY; fails=$((fails + 1)); last_try=$now
        log "MVHR=0 while expected on -> recovery #$fails (off, on) $(measure)"
        TDM_GUARD=1 /usr/bin/tdm off >> "$LOG" 2>&1
        sleep 3   # proven manual timing: off, 3 s, on, 10 s
        TDM_GUARD=1 /usr/bin/tdm on  >> "$LOG" 2>&1
        sleep 10
        log "recovery #$fails result status=$(/usr/bin/tdm status) $(measure)"
        state=TDM_ACTIVE
    else
        if [ "$fails" -ne 0 ] || [ "$state" != TDM_ACTIVE ]; then
            fails=0; state=TDM_ACTIVE; log "link ok (MVHR=1)"
        fi
    fi
done
